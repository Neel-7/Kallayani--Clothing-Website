{
  "name": "kallayani-storefront",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-firebase.mjs",
    "dev:live": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "firebase:emulators": "node scripts/start-firebase-emulators.mjs",
    "firebase:seed": "node --env-file=.env.local --import tsx scripts/seed-firestore.ts",
    "firebase:seed:dry": "node --env-file=.env.local --import tsx scripts/seed-firestore.ts --dry-run",
    "firebase:verify": "node --env-file=.env.local --import tsx scripts/verify-firestore.ts",
    "firebase:verify:media": "node --env-file=.env.local --import tsx scripts/verify-firestore.ts --require-storage-media",
    "firebase:set-role": "node --env-file=.env.local --import tsx scripts/set-firebase-role.ts",
    "firebase:migrate:media": "node --env-file=.env.local --import tsx scripts/migrate-catalog-media.ts",
    "firebase:phase1:check": "node scripts/check-firebase-phase-1.mjs",
    "firebase:deploy:dev": "firebase deploy --only firestore:rules,firestore:indexes,storage --project kallayani-storefront-dev",
    "firebase:deploy:staging": "firebase deploy --only firestore:rules,firestore:indexes,storage --project kallayani-storefront-staging",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@reduxjs/toolkit": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.7",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0"
  }
}
