rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Phase 1 secure baseline: Storage is not part of the storefront yet.
    // Phase 4 will replace this with claim-, path-, size-, and MIME-aware rules
    // before Phase 7 enables catalogue uploads.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
